# First-commit allowlist: new files require review and an explicit rule.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/garmin_sync.py
!/history_update.py
!/processing_audit.py
!/scripts/
/scripts/*
!/scripts/Verify-Python.ps1
!/scripts/Invoke-ReadOnlyDryRun.ps1
!/scripts/Import-GarminKey.ps1
!/scripts/CredentialSupport.ps1
!/tests/
/tests/*
!/tests/Test-CredentialImport.ps1
!/tests/test_sync.py
!/tests/test_transport_fit.py
!/tests/test_processing_audit.py
!/tests/test_comparable_processing.py
!/tests/test_history_update.py

# Defense in depth: personal data and credentials excluded everywhere.
*.json
*.json.*
*.fit
*.FIT
*.[fF][iI][tT]
*.zip
*.bak
*.backup
*.dpapi
*.pem
*.key
*.pfx
*.p12
*.csv
*.gpx
*.tcx
*.lock
*.tmp
*.log
.env
.env.*
api_key*
*token*
secrets/
credentials/
private/
data/
backups/
tests/credential-test-*/

# Python local environment and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/
